# Copy this file to .env.local and fill in real values.
# .env.local is never included in the zip (it holds secrets) and gets
# wiped if you ever robocopy /MIR without excluding it — keep a copy
# of your real values somewhere safe (password manager) so recreating
# this is just copy-paste, not re-typing from memory.

# Prefixes every image/PDF path. Point at your S3/CloudFront URL,
# or leave blank to use local /public files during development.
NEXT_PUBLIC_ASSET_BASE_URL=

# Kit -> Settings -> Developer -> V4 Keys (not the "V3 Key" section)
KIT_API_KEY=
KIT_FORM_ID=9714605

# Stripe -> Developers -> API keys -> Secret key
# Use a sk_test_... key while developing, sk_live_... only when ready
# to accept real payments.
STRIPE_SECRET_KEY=
